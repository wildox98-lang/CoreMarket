# PostgreSQL connection used by Prisma (see prisma.config.ts). Locally this can
# point at a local Postgres instance; in Vercel, add a Postgres storage
# (Vercel Postgres/Neon, or your own) and it will provide this value for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coremarket"

# Public site URL, used to build Mercado Pago back_urls and the webhook notification_url.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mercado Pago Checkout Pro credentials (https://www.mercadopago.com.ar/developers/panel).
# Checkout falls back to a "we'll contact you on WhatsApp" flow when this is unset.
MP_ACCESS_TOKEN=""

# Optional: secret configured in "Tus integraciones" > Webhooks, used to verify
# that incoming payment notifications really come from Mercado Pago.
MP_WEBHOOK_SECRET=""
