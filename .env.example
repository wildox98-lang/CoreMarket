# PostgreSQL connection used by Prisma (see prisma.config.ts). Locally this can
# point at a local Postgres instance; in Vercel, add a Postgres storage
# (Vercel Postgres/Neon, or your own) and it will provide this value for you.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coremarket"

# Public site URL, used to build Mercado Pago back_urls and the webhook notification_url.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mercado Pago Checkout Pro credentials (https://www.mercadopago.com.ar/developers/panel).
# Checkout falls back to a "we'll contact you on WhatsApp" flow when this is unset.
MP_ACCESS_TOKEN=""

# Optional: secret configured in "Tus integraciones" > Webhooks, used to verify
# that incoming payment notifications really come from Mercado Pago.
MP_WEBHOOK_SECRET=""

# TiendaNube/Nuvemshop app credentials (Portal de Socios > Aplicaciones > tu app > Claves de Acceso).
TIENDANUBE_CLIENT_ID=""
TIENDANUBE_CLIENT_SECRET=""

# Filled in once, by hand, after completing the OAuth install at
# /api/tiendanube/callback (see that route for instructions). Access tokens
# don't expire, so this is a one-time setup step, not a runtime flow.
TIENDANUBE_ACCESS_TOKEN=""
TIENDANUBE_STORE_ID=""

# Shared secret required by /api/tiendanube/sync-products (Authorization: Bearer <value>)
# to push the local catalog into TiendaNube. Only needed for the one-time initial load.
TIENDANUBE_SYNC_SECRET=""

# Resend (https://resend.com) — sends the "nuevo pedido pagado" notification to
# STORE.notificationEmail (src/lib/constants.ts) when a payment is confirmed.
RESEND_API_KEY=""
# Optional: defaults to Resend's shared sandbox sender, which only works when
# sending to your own Resend account email. Once the domain is verified in
# Resend, set this to something like "Core Market <pedidos@coremarket.com.ar>".
RESEND_FROM_EMAIL=""
